    {
      "parameters": {
        "jsCode": "const currRuns = parseInt($('IPL Api').item.json.matches[\"Match 1\"].score_1.split(\"/\")[0]) || 0;\n\nconst currWickets = parseInt($('IPL Api').item.json.matches[\"Match 1\"].score_1.split(\"/\")[1]) || 0;\n\nconst currOvers = $('IPL Api').item.json.matches[\"Match 1\"].overs_1;\n\n// Previous data from current input item\nconst prevRuns = parseInt($json.prev_runs) || 0;\nconst prevWickets = parseInt($json.prev_wickets) || 0;\n\nconst runDiff = currRuns - prevRuns;\nconst wicketDiff = currWickets - prevWickets;\n\nlet moment = null;\n\nif (runDiff >= 6) {\n  moment = \"six\";\n}\nelse if (runDiff === 4) {\n  moment = \"boundary\";\n}\nelse if (wicketDiff > 0) {\n  moment = \"wicket\";\n}\nelse if ($('IPL Api').item.json.status === \"completed\") {\n  moment = \"win\";\n}\n\nreturn [{\n  json: {\n    moment,\n    runs: currRuns,\n    wickets: currWickets,\n    overs: currOvers,\n    score: currRuns + \"/\" + currWickets,\n    player: \"MI Batsman\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1488,
        272
      ],
      "id": "f0687bc6-5df6-49e2-a23f-7b721cbf3015",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a Hinglish copywriter for a brand during a live IPL match.\\n\\nBrand Name: {{ $json.brand_name }}\\nProduct Type: {{ $json.product_type }}\\nTone: {{ $json.brand_tone }}\\nCricket Moment: {{ $('Moment').item.json.moment }}\\n\\nWrite ONE short Hinglish caption.\\nMaximum 12 words.\\nUse emoji if relevant.\\nNo hashtags.\\nNo quotation marks.\\nNo explanation.\\nOnly return the caption text.\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
