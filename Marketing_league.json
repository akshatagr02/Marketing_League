        "bodyParameters": {
          "parameters": [
            {
              "name": "html",
              "value": "=<div style=\"\nbackground:linear-gradient(135deg,#0f172a,#1e293b);\nwidth:600px;\nheight:600px;\npadding:30px;\nborder-radius:24px;\nfont-family:sans-serif;\ntext-align:center;\ndisplay:flex;\nflex-direction:column;\njustify-content:space-between;\nbox-sizing:border-box;\noverflow:hidden;\nposition:relative;\n\">\n\n  <!-- Top Glow -->\n  <div style=\"\n  position:absolute;\n  top:-80px;\n  right:-80px;\n  width:220px;\n  height:220px;\n  background:#f59e0b33;\n  border-radius:50%;\n  filter:blur(40px);\n  \"></div>\n\n  <!-- Match Moment -->\n  <div style=\"\n  color:#facc15;\n  font-size:42px;\n  font-weight:800;\n  letter-spacing:1px;\n  z-index:2;\n  \">\n    🏏 {{ $('Moment').item.json.moment.toUpperCase() }}\n  </div>\n\n  <!-- Score -->\n  <div style=\"\n  color:#cbd5e1;\n  font-size:18px;\n  z-index:2;\n  \">\n    Over {{ $json.over_team1 }}/20\n    \n    Score {{ $json.score_team1 }}\n  </div>\n\n  <!-- Product Image -->\n  <div style=\"z-index:2;\">\n    <img \n      src=\"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSG0AGBFKJf5x8ARCGvMVmhYTriiNN8s42jwQ&s\"\n      style=\"\n      width:190px;\n      height:190px;\n      object-fit:contain;\n      border-radius:20px;\n      background:white;\n      padding:12px;\n      box-shadow:0 10px 25px rgba(0,0,0,0.4);\n      \"\n    />\n  </div>\n\n  <!-- AI Caption -->\n  <div style=\"\n  color:white;\n  font-size:28px;\n  font-weight:700;\n  line-height:1.4;\n  padding:0 20px;\n  z-index:2;\n  \">\n    {{ $('Line Generator').item.json.candidates[0].content.parts[0].text }}\n  </div>\n\n  <!-- Brand Name -->\n  <div style=\"\n  background:linear-gradient(90deg,#f97316,#ea580c);\n  color:white;\n  padding:16px;\n  border-radius:16px;\n  font-size:24px;\n  font-weight:700;\n  z-index:2;\n  box-shadow:0 6px 18px rgba(249,115,22,0.4);\n  \">\n    {{ $('Get the brand data').item.json.brand_name }}\n  </div>\n\n</div>"
